# Kotak Neo API Credentials for Smoke Tests
# Copy this file to .env and fill in your actual credentials

# Mobile number registered with Kotak Neo (include country code)
NEO_MOBILE_NUMBER=+91XXXXXXXXXX

# Your User Client Code (UCC)
NEO_UCC=XXXXX

# TOTP Secret Key (base32 encoded string from your authenticator app)
# This is the secret key you get when setting up TOTP, not the 6-digit code
NEO_TOTP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Your MPIN for 2FA validation
NEO_MPIN=XXXXXX
