# ============================================================================
# SDK DEVELOPER-ONLY environment template
# ============================================================================
# This file is for contributors working on the Kotak Neo Python SDK itself.
# Normal users installing from PyPI / cloning the repo do NOT need this — the
# SDK always talks to the production environment by default (see .env.example).
#
# Copy to .env and fill in credentials to run tests against a specific
# environment.

# ----- Environment selection (SDK developers only) --------------------------
# Selects which Kotak backend the client talks to.
#   prod : production (default everywhere when this is unset)
#   uat  : internal UAT / testing backend
# Leave unset for production behaviour.
NEO_ENVIRONMENT=uat

# ----- Credentials ----------------------------------------------------------
NEO_CONSUMER_KEY=your-consumer-key-token-here
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=XXXXX
NEO_TOTP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEO_MPIN=XXXXXX
